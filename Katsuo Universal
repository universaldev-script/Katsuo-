    tpTitle.TextScaled = true
    tpTitle.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    tpTitle.TextColor3 = Color3.new(1,1,1)
    tpTitle.Font = Enum.Font.GothamBold
    
    local setBtn = Instance.new("TextButton", tpFrame)
